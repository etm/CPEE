CDIR=$(dirname "$0")
echo "CDir is: ${CDIR}"
INSTANCE_DIR=$1
echo "Instance dir is: $INSTANCE_DIR"
INSTANCE_ID=$(basename $INSTANCE_DIR)
echo "Instance_ID is: $INSTANCE_ID"

# copy source code over
ln -s "$CDIR/rusty_weel/http_helper" $INSTANCE_DIR
ln -s "$CDIR/rusty_weel/weel_lib" $INSTANCE_DIR
ln -s "$CDIR/rusty_weel/weel_macro" $INSTANCE_DIR
cp -r "$CDIR/rusty_weel/weel_bin" $INSTANCE_DIR
mv -f "$INSTANCE_DIR/instance.rs" "$INSTANCE_DIR/weel_bin"

# Link build dir directly into binary crate dir
ln -s "$CDIR/target" "$INSTANCE_DIR/weel_bin"

# copy and run build script (will crate instance binary
ln -s "$CDIR/build" $INSTANCE_DIR
cd $INSTANCE_DIR
./build $INSTANCE_ID

# Dynlink the run script
ln -s "$CDIR/run" $INSTANCE_DIR
