INSTANCE_ID=$(grep -Po '(?<=\"instance_id\": )(\d+)' opts.json)
BIN_NAME="weel_bin_$INSTANCE_ID"
sed -i "s/name = \"weel_bin\"/name = \"$BIN_NAME\"/" ./weel_bin/Cargo.toml

RUSTFLAGS='-C prefer-dynamic -Awarnings' cargo build --release
#/usr/bin/time  -f  "%E real, %U user, %S sys, %K avg-mem, %M RSS-mem %D Unique-mem" -o res.txt echo $RUSTFLAGS
