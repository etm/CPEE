<element rngui:version="1.2" name="rules" ns="http://cpee.org/ns/properties/2.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes" xmlns="http://relaxng.org/ns/structure/1.0" xmlns:rngui="http://rngui.org">
  <zeroOrMore rngui:label="Create Rules">
    <element name='rule' rngui:header='Rule'>
      <element name='rule_id' rngui:label='Rule Identifier'>
        <data type="string" rngui:label="value"/>
      </element>
      <optional>
        <element name='interval' rngui:label='Interval Identifier'>
          <data type="string" rngui:label="value"/>
        </element>
      </optional>
      <optional>
        <element name='trigger' rngui:label='Trigger (event, data, endpoints, trace, instance_count, instance_open_count)'>
          <text rngui:label="value"/>
        </element>
      </optional>
      <optional>
        <element name='condition' rngui:label='Condition (event, data, endpoints, trace, instance_count, instance_open_count)'>
          <text rngui:label="value"/>
        </element>
      </optional>
      <element name='state' rngui:label='State (event, data, endpoints, trace, trigger_e, initialized_ts, interval, state, scratch_pad)'>
        <text rngui:label="value"/>
      </element>
      <optional>
        <element name='termination' rngui:label='Termination (event, data, endpoints, trace, trigger_e, initialized_ts, interval, state, scratch_pad)'>
          <text rngui:label="value"/>
        </element>
      </optional>
      <optional>
        <element name='action_sat' rngui:label='Satisfaction Action (event, data, endpoints, trace, trigger_e, initialized_ts, interval, state, scratch_pad)'>
          <text rngui:label="value"/>
        </element>
      </optional>
      <optional>
        <element name='action_viol' rngui:label='Compensation Action (event, data, endpoints, trace, trigger_e, initialized_ts, interval, state, scratch_pad)'>
          <text rngui:label="value"/>
        </element>
      </optional>
    </element>
  </zeroOrMore>
</element>
