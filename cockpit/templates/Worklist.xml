  <attributes>
    <info>Worklist</info>
    <modeltype>CPEE</modeltype>
    <theme>extended</theme>
    <organisation1>https://cpee.org/~demo/orgviz/organisation_informatik.xml</organisation1>
    <creator>Christine Ashcreek</creator>
