<?xml version="1.0"?>
<testset xmlns="http://cpee.org/ns/properties/2.0">
  <executionhandler>ruby</executionhandler>
  <dataelements>
    <location/>
    <category/>
    <description/>
    <urgency/>
    <priority/>
    <technician_id/>
    <materials_needed>false</materials_needed>
    <materials_list/>
    <materials_issued>false</materials_issued>
    <repair_notes/>
    <satisfied>false</satisfied>
    <rating/>
    <feedback/>
  </dataelements>
  <endpoints>
    <worklist>https-post://cpee.org/worklist/server/</worklist>
