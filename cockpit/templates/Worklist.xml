            <documentation>
              <input/>
              <output/>
              <implementation>
                <description/>
              </implementation>
              <code>
                <description/>
              </code>
            </documentation>
          </call>
          <_probability>
            <_probability_min/>
            <_probability_max/>
            <_probability_avg/>
          </_probability>
        </alternative>
        <otherwise eid="e3"/>
      </choose>
      <call id="a3" endpoint="worklist">
        <parameters>
          <label>Carry out repair &amp; mark complete</label>
          <color/>
          <arguments>
            <orgmodel/>
            <form/>
            <role>Technician</role>
            <priority>1</priority>
            <handling>single</handling>
            <restrictions/>
            <data/>
